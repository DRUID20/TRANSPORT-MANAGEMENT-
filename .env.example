# ========================
# Supabase
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ========================
# Database (Supabase Postgres direct connection for Drizzle)
# ========================
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ========================
# Sentry
# ========================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=tx-system

# ========================
# FX (CBK + Frankfurter fallback)
# ========================
FX_CRON_SECRET=change-me-to-a-long-random-string
FX_WATCHLIST=USD,UGX,TZS,RWF

# ========================
# Africa's Talking (notifications)
# ========================
AT_USERNAME=
AT_API_KEY=

# ========================
# M-Pesa Daraja (sandbox first)
# ========================
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# ========================
# Anthropic (for OCR + report Q&A in later phases)
# ========================
ANTHROPIC_API_KEY=

# ========================
# App
# ========================
NEXT_PUBLIC_APP_NAME=TX System
NEXT_PUBLIC_APP_URL=http://localhost:3000
